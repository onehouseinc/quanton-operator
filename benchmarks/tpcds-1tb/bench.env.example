# Configuration for the TPC-DS 1 TB benchmark.
#
# Copy this file to bench.env, fill in the first section, and run ./run.sh. Everything else
# already has a working default. bench.env is gitignored because it names your buckets and
# your cluster.
#
#   cp bench.env.example bench.env

# ---------------------------------------------------------------------------
# Required: where the data lives and where the jobs run
# ---------------------------------------------------------------------------

# Object storage base for every dataset this suite writes. Use the s3a:// scheme on AWS and
# gs:// on Google Cloud. The suite creates parquet/, hudi/, iceberg/ and merge-batches/
# underneath it.
STORAGE_URI=s3a://CHANGE-ME/tpcds

# Kubernetes namespace and the service account the driver runs as. The service account needs
# read and write access to STORAGE_URI, normally through IRSA on AWS or Workload Identity on
# Google Cloud.
NAMESPACE=spark-benchmarks
SERVICE_ACCOUNT=spark

# Benchmark image built from ./Dockerfile, pushed to a registry your cluster can pull from.
# Build it for the architecture of your nodes.
BENCH_IMAGE=CHANGE-ME/tpcds-bench:1.0

# ---------------------------------------------------------------------------
# Scale and scope
# ---------------------------------------------------------------------------

# Scale factor in gigabytes. 1000 is the 1 TB dataset.
SCALE_FACTOR=1000

# Formats to build and measure, and engines to compare.
FORMATS="parquet hudi iceberg"
ENGINES="oss quanton"

# Number of dsdgen chunks for the tables that grow with the scale factor. Roughly four times
# the total executor core count works well. Each chunk needs about SCALE_FACTOR/PARALLEL GB
# of executor local disk while it is being generated.
DSDGEN_PARALLEL=400

# Timed rounds over the 99 queries. The reported time per query is the best round.
QUERY_ROUNDS=1
# Run one untimed round first, so a cold object-storage cache does not decide the result.
QUERY_WARMUP=true
# Optional subset for a quick check, for example "1,23,67". Empty means all 99.
QUERY_NUMBERS=""

# ---------------------------------------------------------------------------
# Lake-loader merge benchmark
# ---------------------------------------------------------------------------

# Merge rounds per format per engine.
MERGE_ROUNDS=5
# Fact table the merges target.
MERGE_TABLE=store_sales
# Share of existing rows updated, and share of new rows inserted, in each round.
MERGE_UPDATE_FRACTION=0.01
MERGE_INSERT_FRACTION=0.002
# Each engine merges into its own copy of the target, built from this share of the source.
# Lower it to 0.1 to keep the merge phase short while still merging into a large table.
MERGE_SOURCE_FRACTION=1.0

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------

SPARK_VERSION=3.5.2
DRIVER_CORES=4
DRIVER_MEMORY=24g
EXECUTOR_INSTANCES=4
EXECUTOR_CORES=32
EXECUTOR_CORE_LIMIT=32500m
EXECUTOR_MEMORY=200g
MEMORY_OVERHEAD_FACTOR=0.2
SHUFFLE_PARTITIONS=2000
# Scratch volume for shuffle files and for dsdgen output.
LOCAL_DIR_SIZE=200Gi

# The four JSON values below must be in single quotes, so the shell keeps their double
# quotes. run.sh checks them and names the offender if one is malformed.
#
# Restrict the benchmark to a node pool, as a JSON object. {} means no restriction.
NODE_SELECTOR='{}'
# Image pull secrets, as a JSON array, for example ["my-registry-creds"].
IMAGE_PULL_SECRETS='[]'
IMAGE_PULL_POLICY=IfNotPresent

# ---------------------------------------------------------------------------
# Format options
# ---------------------------------------------------------------------------

# none keeps all three formats structurally identical, which makes the engine comparison
# clean. date partitions the fact tables by their date surrogate key, which is closer to a
# production layout and usually makes merges faster.
PARTITION_FACTS=none

HUDI_TABLE_TYPE=COPY_ON_WRITE
# BLOOM is the Hudi default. RECORD_INDEX is usually faster for upserts into a large table.
HUDI_INDEX_TYPE=BLOOM
ICEBERG_WRITE_MODE=copy-on-write
ICEBERG_CATALOG=lakehouse
ICEBERG_DATABASE=tpcds

# The Quanton engine image bundles the Iceberg runtime but not Hudi. Point this at a Hudi
# bundle jar in object storage to avoid depending on Maven Central from inside your cluster.
# Leave it empty to resolve the bundle through spark.jars.packages instead.
QUANTON_HUDI_JARS=""
HUDI_BUNDLE_COORDINATES=org.apache.hudi:hudi-spark3.5-bundle_2.12:0.15.0

# ---------------------------------------------------------------------------
# Object storage details
# ---------------------------------------------------------------------------

# Leave empty on AWS S3. Set it for MinIO or another S3-compatible endpoint.
S3_ENDPOINT=""
# Leave empty to use the default credential chain, which is what IRSA and Workload Identity
# rely on. Set it only when you inject static keys through a secret.
S3_CREDENTIALS_PROVIDER=""
# Extra environment for the driver and executors, as a JSON array, for example
# [{"name":"AWS_REGION","value":"us-west-2"}].
EXTRA_ENV='[]'

# Extra Spark configuration merged into every job, as JSON, for example
# {"spark.sql.adaptive.coalescePartitions.enabled":"true"}.
EXTRA_SPARK_CONF='{}'

# How long a single phase may run before run.sh gives up, in seconds.
PHASE_TIMEOUT=43200
